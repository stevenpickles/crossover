<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>crossover</id>
    <!-- A placeholder: pack.ps1 always stamps the real version, taken from
         what the built binaries report. Kept in step with the workspace
         version anyway, so a hand-run `choco pack` here cannot mint a
         package claiming a version that no longer exists. -->
    <version>0.2.0</version>
    <title>Crossover</title>
    <authors>Steven Pickles</authors>
    <owners>Steven Pickles</owners>
    <projectUrl>https://github.com/stevenpickles/crossover</projectUrl>
    <licenseUrl>https://github.com/stevenpickles/crossover/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <!-- Chocolatey CLI does not support the embedded <icon> element (CHCU0002);
         it references the logo by URL. Resolves once the logo is on `main`. -->
    <iconUrl>https://raw.githubusercontent.com/stevenpickles/crossover/main/assets/branding/crossover-logo.png</iconUrl>
    <tags>crossover kvm keyboard mouse clipboard synergy remote-input</tags>
    <summary>Secure keyboard, mouse, and clipboard sharing between trusted computers.</summary>
    <description>
Crossover shares one keyboard, mouse, and clipboard across two trusted
computers over a pinned mutual-TLS link. Installing deploys crossover.exe,
crossover-svc.exe and crossover-layout.exe to Program Files and registers a
background service that launches the worker into your logon session and keeps
it running (ADR 0011). `crossover layout` opens the editor, where both
machines' monitors are arranged into the layout they physically sit in
(ADR 0018, ADR 0019).

The binaries are embedded in this package (suited to a local or private feed).
For the public community repository, switch tools\chocolateyInstall.ps1 to
download the executables from a release URL instead.
    </description>
  </metadata>
  <files>
    <!-- tools\ carries the install scripts and the staged executables. -->
    <file src="tools\**" target="tools" />
  </files>
</package>
